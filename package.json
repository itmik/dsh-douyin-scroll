{
  "name": "dsh-douyin-scroll",
  "version": "0.1.0",
  "description": "DSH 插件：每天替你刷一轮抖音 —— 走浏览器拿真实数据，挑出值得的、写一份日报，值得的就 @ 你",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "profile-template",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "README.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "playwright-core": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}